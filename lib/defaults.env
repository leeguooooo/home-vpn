# 所有站点参数的默认值。site/site.env 里写了同名的就以它为准（shell 和 Python 都按这个顺序读：先这里，再 site.env）。
# 这里只放「换一个人部署也不用改」的东西；域名、IP 这类每家都不同的，只在 site/site.env 里（模板见 site.example/）。

# ---------------------------------------------------------------- 名字（用户看得到的）
BRAND=家里线路                         # 用户版 App、托盘、订阅页的名字。服务器在美国就写「美国线路」
EXIT_NAME=家里                         # 状态文字里出口的叫法：「已连接 · 家里」「出口不是家里的 IP」
NODE_PREFIX=Home                       # 手机 / Clash 订阅里节点名的前缀：Home-HY2-v4
EXIT_COUNTRY=                          # 出口所在国家码（如 JP、US）：用户版托盘拿它核对出口；空 = 不核对

# ---------------------------------------------------------------- 名字（内部用，部署之后别再改）
SHARED_USER=me                         # 共用账号（管理员自己的设备用它）。不能增删，不会到期
OWNER_USERS=                           # 能经代理访问服务器所在局域网的账号，空格分隔；空 = 只有 SHARED_USER
STATE_DIR='~/.home-vpn'                # 服务端数据：密码、证书、用户、日志（ssh 命令里也用，别展开）
SLUG=home-vpn                          # 文件名、计划任务名的前缀（Windows 回国通道、缓存目录等）
APP_ID=HomeVPN                         # 用户版的程序名 / 目录名：/Library/Application Support/<APP_ID>、C:\ProgramData\<APP_ID>
CLIENT_NAME=home-vpn-client            # 管理员 Mac 客户端：目录 ~/<CLIENT_NAME>、sudoers 文件名、/tmp 日志名
CLIENT_LABEL=io.github.home-vpn.client
MENUBAR_LABEL=io.github.home-vpn.menubar
UPNP_DESC=home-vpn                     # 路由器上 UPnP 端口映射的描述

# 服务端开机任务（macOS launchd 标签 / Linux systemd --user 单元名）
LABEL_NODE=io.github.home-vpn.node
LABEL_MAINT=io.github.home-vpn.maint
LABEL_UPNP=io.github.home-vpn.upnp
LABEL_DDNS=io.github.home-vpn.ddns
LABEL_KEYS=io.github.home-vpn.keys

# ---------------------------------------------------------------- 协议和端口
HY2_V4_PORT=443                        # UDP，监听 0.0.0.0（macOS 普通用户只能把 <1024 端口绑在通配地址上）
HY2_V6_PORT=8443                       # UDP，绑在稳定（非 temporary）IPv6 上：绑 :: 会从临时地址回包，HY2 客户端会丢
STLS_PORT=443                          # TCP，ShadowTLS v3，握手借 STLS_HANDSHAKE
STLS_HANDSHAKE=www.apple.com
SS_METHOD=2022-blake3-aes-128-gcm
HY2_UP_MBPS=0                          # 0 = 上传不用 Brutal（普通拥塞控制）。见 docs/gotchas.md
HY2_DOWN_MBPS=100
SINGBOX_VERSION=1.14.1                 # Windows / Mac 用户版、Linux 服务端用的 sing-box 版本

# ---------------------------------------------------------------- 可选功能（空 = 不启用）
UPNP=auto                              # auto：装了 miniupnpc 且路由器支持就映射端口；off：VPS / 手动转发
NET_IFACE=                             # 空 = 自动找默认路由所在的网卡
SERVER_V4_HOST=
DDNS_ENV='~/.config/cloudflare-ddns.env'
GITHUB_KEYS_USER=
CN_EXIT_USER=
CN_EXIT_PORT=18090
SERVER_SSH_USER=
SUB_BASE=
