# 放到服务器的 ~/.config/cloudflare-ddns.env（site.env 的 DDNS_ENV 可以改位置），chmod 600。不进 git。
# 令牌权限：Zone → DNS → Edit，只给这一个域名。记录 id：先在 Cloudflare 后台建好记录，再
#   curl -H "Authorization: Bearer $CF_API_TOKEN" https://api.cloudflare.com/client/v4/zones/$CF_ZONE_ID/dns_records?name=vpn.example.com
CF_API_TOKEN=
CF_ZONE_ID=
CF_RECORD_ID=                # AAAA 记录（SERVER_DOMAIN）
CF_RECORD_NAME=vpn.example.com
# 可选：家宽 IPv4 会变时，再维护一条 A 记录（SERVER_V4_HOST）
CF_RECORD_ID4=
CF_RECORD_NAME4=
