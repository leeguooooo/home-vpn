# 你这套部署的参数。复制一份再改：cp -R site.example site（site/ 不进 git，可以单独放进你自己的私有仓库）。
# 这里没有任何密码：密码、证书在服务器第一次安装时生成，只存在服务器的 STATE_DIR（默认 ~/.home-vpn）。
# 没写的参数用 lib/defaults.env 里的默认值；要改名字、端口、开关就把那一行抄过来改。

# ---------------------------------------------------------------- 服务器（出口）
SERVER_DOMAIN=vpn.example.com          # 指向服务器的域名，也是 HY2 证书的名字。有 IPv6 就给它 AAAA 记录（server/ddns.sh 能自动维护）
SERVER_V4=203.0.113.10                 # 服务器的公网 IPv4（家宽就是路由器的外网地址）。客户端拿它判断「出口对不对」
SERVER_V4_HOST=                        # 家宽 IPv4 会变的话填一个跟着它的域名（A 记录，server/ddns.sh 可以维护）；空 = 直接连 SERVER_V4
NET_IFACE=                             # 服务器网卡；空 = 自动找（macOS 常见 en0，Linux 常见 eth0）

# ---------------------------------------------------------------- 客户端从哪取配置
SERVER_SSH=vpn-server                  # 客户端安装脚本 ssh 到服务器用的主机名（~/.ssh/config 里的别名，见 client/ssh-config.example）
SERVER_REPO='~/home-vpn'               # 服务器上这个仓库的位置（ssh 命令里用，别展开）
GITHUB_KEYS_USER=                      # 填你的 GitHub 用户名：服务器每 15 分钟把 github.com/<用户名>.keys 同步进 authorized_keys，
                                       # 新电脑 `gh ssh-key add` 之后就能装客户端。空 = 不同步，自己管 authorized_keys

# ---------------------------------------------------------------- 名字
SHARED_USER=me                         # 你自己设备用的共用账号
BRAND=家里线路                         # 给别人用的 App / 订阅页的名字，比如「东京线路」「美国线路」
EXIT_NAME=家里                         # 状态文字里出口的叫法：「已连接 · 家里」
EXIT_COUNTRY=                          # 出口国家码（JP、US…），用户版托盘拿它核对出口；空 = 不核对

# ---------------------------------------------------------------- 可选功能
UPNP=auto                              # 家宽：路由器支持 UPnP 就自动映射 443 端口。VPS 或自己在路由器上转发了就写 off
SUB_BASE=                              # 订阅服务地址（sub/ 部署到 Cloudflare 后的自定义域名，如 https://sub.example.com）；空 = 不用订阅
CN_EXIT_USER=                          # 「回国」账号名（如 cn）。要国内家里有一台 Windows 开着，见 README「回国出口」；空 = 不启用
SERVER_SSH_USER=                       # 回国：国内那台电脑 ssh 登录服务器用的账号
